# =====================================================================
# PostgreSQL local — Club Deportivo
# Copiar a .env (ignorado por git) y ajustar si hace falta.
# =====================================================================

POSTGRES_DB=club_deportivo
POSTGRES_USER=club_deportivo
POSTGRES_PASSWORD=club_deportivo_dev
POSTGRES_PORT=5433

# =====================================================================
# Stack completo en Docker (backend + frontend)
# =====================================================================
# Secreto JWT de desarrollo; en producción usar uno real.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRATION=24h

# Pool de Prisma por proceso (instancias × workers + margen).
DB_CONNECTION_LIMIT=5

# Orígenes permitidos por el backend.
CORS_ORIGINS=http://localhost:3000

# URL que el navegador usa para llegar al backend (se hornea en el build).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
