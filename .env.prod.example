# =====================================================================
# Variables de entorno para producción (AWS EC2 / Lightsail + Caddy)
# Archivo de referencia: .env.prod.example
# Copiar como .env.prod en el servidor o inyectar como GitHub Secrets
# =====================================================================

# Dominio público y URL base de API
DOMAIN_NAME=clubdeportivo.alquilerespunilla.com.ar
NEXT_PUBLIC_API_URL=https://clubdeportivo.alquilerespunilla.com.ar/api/v1
CORS_ORIGINS=https://clubdeportivo.alquilerespunilla.com.ar

# Base de datos PostgreSQL
POSTGRES_DB=club_deportivo
POSTGRES_USER=club_deportivo
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_MUY_SEGURO_PRODUCCION

# Seguridad JWT
JWT_SECRET=CAMBIAR_POR_TOKEN_CRIPTOGRAFICO_ALEATORIO_DE_MINIMO_32_CHARS
JWT_EXPIRATION=24h
DB_CONNECTION_LIMIT=10

# Imágenes de Docker (en caso de usar registry GHCR o ECR)
# BACKEND_IMAGE=ghcr.io/gasparna/club-deportivo-backend:latest
# FRONTEND_IMAGE=ghcr.io/gasparna/club-deportivo-frontend:latest
