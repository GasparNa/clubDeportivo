# =====================================================================
# Base de datos
# =====================================================================
# Local (Docker): levantar con `pnpm db:up` desde la raíz del repo.
DATABASE_URL="postgresql://club_deportivo:club_deportivo_dev@localhost:5433/club_deportivo?schema=public"

# Supabase (staging/producción) — session pooler, puerto 5432:
# DATABASE_URL="postgresql://postgres.[REF]:[PASS]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# Alternativa transaction pooler (puerto 6543), solo para conexiones cortas:
# DATABASE_URL="postgresql://postgres.[REF]:[PASS]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# JWT
# Obligatorio con NODE_ENV=production: el backend no arranca si falta.
JWT_SECRET="your-jwt-secret-change-me"
JWT_EXPIRATION="24h"

# App
PORT=3001
NODE_ENV=development

# Pool de Prisma por proceso (se agrega a DATABASE_URL como connection_limit).
# Regla: instancias × workers + margen. Ej.: 2 instancias × 1 worker + 1 = 5.
# Dejar vacío para usar el default de Prisma.
DB_CONNECTION_LIMIT=5

# Orígenes permitidos para CORS (lista separada por comas).
# En desarrollo alcanza con los defaults de localhost.
# En producción agregar el dominio del frontend, ej:
# CORS_ORIGINS="https://club-deportivo-phi.vercel.app"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
